// =========================================================================
// MODULE 19: SECURE INTEGRATION, API GATEWAY & CONNECTIVITY ENGINE MODELS
// =========================================================================

model Integration {
  id               String   @id @default(uuid())
  integrationCode  String   @unique
  name             String
  description      String?
  provider         String
  category         String   // CRM, ACCOUNTING, PAYMENTS, COMMUNICATION, MARKETING, PROJECT_MANAGEMENT, ANALYTICS, AI, STORAGE, IDENTITY, CUSTOM
  status           String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, DISABLED, ERROR
  version          String?
  documentationUrl String?
  isActive         Boolean  @default(true)
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connections IntegrationConnection[]
  endpoints   IntegrationEndpoint[]
  webhooks    IntegrationWebhook[]
  events      IntegrationEvent[]
  jobs        IntegrationJob[]
  mappings    IntegrationMapping[]
  logs        IntegrationLog[]
  healths     IntegrationHealth[]

  @@index([provider])
  @@index([category])
  @@index([status])
  @@index([isActive])
}

model IntegrationConnection {
  id                  String    @id @default(uuid())
  integrationId       String
  connectionCode      String    @unique
  name                String
  environment         String    @default("PRODUCTION") // DEVELOPMENT, STAGING, PRODUCTION
  status              String    @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, DISABLED, ERROR
  authType            String    // API_KEY, OAUTH2, BEARER, BASIC, HMAC, CUSTOM
  credentialReference String    // MUST NOT CONTAIN RAW CREDENTIALS
  configurationJson   String?
  lastTestedAt        DateTime?
  lastSuccessfulAt    DateTime?
  lastFailureAt       DateTime?
  failureReason       String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  integration Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  events      IntegrationEvent[]
  jobs        IntegrationJob[]
  logs        IntegrationLog[]
  healths     IntegrationHealth[]

  @@index([integrationId])
  @@index([environment])
  @@index([status])
  @@index([authType])
}

model IntegrationEndpoint {
  id              String   @id @default(uuid())
  integrationId   String
  name            String
  method          String   // GET, POST, PUT, PATCH, DELETE
  path            String
  purpose         String
  direction       String   // INBOUND, OUTBOUND
  isActive        Boolean  @default(true)
  timeoutMs       Int      @default(30000)
  retryPolicyJson String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([direction])
  @@index([isActive])
}

model IntegrationWebhook {
  id                 String    @id @default(uuid())
  integrationId      String
  webhookCode        String    @unique
  name               String
  endpointPath       String
  secretReference    String    // NEVER STORE RAW WEBHOOK SECRETS
  signatureAlgorithm String    @default("HMAC_SHA256")
  eventType          String
  isActive           Boolean   @default(true)
  lastReceivedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([webhookCode])
  @@index([eventType])
  @@index([isActive])
}

model IntegrationEvent {
  id              String    @id @default(uuid())
  eventCode       String    @unique
  integrationId   String?
  connectionId    String?
  direction       String    // INBOUND, OUTBOUND
  eventType       String
  externalEventId String?
  idempotencyKey  String    @unique
  payloadHash     String
  status          String    @default("RECEIVED") // RECEIVED, PROCESSING, PROCESSED, FAILED, IGNORED, RETRYING, DEAD_LETTER
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  error           String?
  correlationId   String?
  metadataJson    String?

  integration Integration?           @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  connection  IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  logs        IntegrationLog[]

  @@index([integrationId])
  @@index([connectionId])
  @@index([direction])
  @@index([eventType])
  @@index([status])
  @@index([externalEventId])
  @@index([correlationId])
}

model IntegrationJob {
  id            String    @id @default(uuid())
  jobCode       String    @unique
  integrationId String
  connectionId  String?
  jobType       String
  status        String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, RETRYING, CANCELLED, DEAD_LETTER
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5)
  nextRetryAt   DateTime?
  error         String?
  metadataJson  String?

  integration Integration            @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  connection  IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  logs        IntegrationLog[]

  @@index([integrationId])
  @@index([connectionId])
  @@index([jobType])
  @@index([status])
  @@index([nextRetryAt])
}

model IntegrationMapping {
  id                 String   @id @default(uuid())
  mappingCode        String   @unique
  integrationId      String
  sourceSystem       String
  targetSystem       String
  sourceEntity       String
  targetEntity       String
  mappingJson        String
  transformerVersion String?
  isActive           Boolean  @default(true)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([sourceSystem, targetSystem])
  @@index([sourceEntity, targetEntity])
  @@index([isActive])
}

model IntegrationLog {
  id            String   @id @default(uuid())
  integrationId String?
  connectionId  String?
  eventId       String?
  jobId         String?
  level         String   // DEBUG, INFO, WARN, ERROR
  eventType     String
  message       String
  statusCode    Int?
  durationMs    Int?
  metadataJson  String?
  createdAt     DateTime @default(now())

  integration Integration?           @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  connection  IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  event       IntegrationEvent?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  job         IntegrationJob?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([connectionId])
  @@index([eventId])
  @@index([jobId])
  @@index([level])
  @@index([createdAt])
}

model IntegrationHealth {
  id               String    @id @default(uuid())
  integrationId    String
  connectionId     String?
  status           String    @default("UNKNOWN") // HEALTHY, DEGRADED, UNAVAILABLE, UNKNOWN
  latencyMs        Float?
  successRate      Float?
  errorRate        Float?
  lastCheckedAt    DateTime  @default(now())
  lastSuccessfulAt DateTime?
  lastFailureAt    DateTime?
  detailsJson      String?

  integration Integration            @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  connection  IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([connectionId])
  @@index([status])
  @@index([lastCheckedAt])
}

// ============================================================
// Module 20 — Platform Resilience, Backup, DR & Business Continuity
// ============================================================

model ResiliencePolicy {
  id           String   @id @default(uuid())
  policyCode   String   @unique
  name         String
  description  String?
  scope        String   // PLATFORM, SERVICE, DATA, INFRASTRUCTURE
  rpoMinutes   Int
  rtoMinutes   Int
  priority     Int      @default(0)
  criticality  String   // CRITICAL, HIGH, MEDIUM, LOW
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User? @relation("ResiliencePolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([criticality])
  @@index([scope])
}

model BackupPlan {
  id                    String    @id @default(uuid())
  planCode              String    @unique
  name                  String
  description           String?
  backupType            String    // FULL, INCREMENTAL, DIFFERENTIAL, SNAPSHOT, CONFIGURATION, DOCUMENT
  frequency             String    // HOURLY, DAILY, WEEKLY, MONTHLY, ON_DEMAND
  retentionDays         Int       @default(30)
  storageReference      String?
  encryptionRequired    Boolean   @default(true)
  verificationRequired  Boolean   @default(true)
  isActive              Boolean   @default(true)
  lastSuccessfulBackupAt DateTime?
  lastFailedBackupAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  executions BackupExecution[]

  @@index([isActive])
  @@index([backupType])
}

model BackupExecution {
  id                 String    @id @default(uuid())
  executionCode      String    @unique
  backupPlanId       String
  status             String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  sizeBytes          BigInt?
  checksum           String?
  storageReference   String?
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, FAILED, NOT_REQUIRED
  errorMessage       String?
  correlationId      String?
  metadataJson       String?
  createdAt          DateTime  @default(now())

  backupPlan BackupPlan @relation(fields: [backupPlanId], references: [id], onDelete: Cascade)

  @@index([backupPlanId])
  @@index([status])
  @@index([startedAt])
  @@index([correlationId])
}

model RecoveryPlan {
  id                    String    @id @default(uuid())
  planCode              String    @unique
  name                  String
  description           String?
  scope                 String    // PLATFORM, SERVICE, DATA, INFRASTRUCTURE
  priority              Int       @default(0)
  targetRpoMinutes      Int
  targetRtoMinutes      Int
  status                String    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, RETIRED
  lastTestedAt          DateTime?
  lastSuccessfulTestAt  DateTime?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  createdBy  User?             @relation("RecoveryPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  steps      RecoveryStep[]
  executions RecoveryExecution[]

  @@index([status])
  @@index([priority])
}

model RecoveryStep {
  id                String   @id @default(uuid())
  recoveryPlanId    String
  stepNumber        Int
  name              String
  description       String?
  stepType          String   // VALIDATION, BACKUP, RESTORE, CONFIGURATION, SERVICE_START, SERVICE_STOP, HEALTH_CHECK, DATA_VERIFICATION, NOTIFICATION, MANUAL_APPROVAL
  commandReference  String?
  dependencyJson    String?
  timeoutSeconds    Int      @default(300)
  isRequired        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recoveryPlan   RecoveryPlan            @relation(fields: [recoveryPlanId], references: [id], onDelete: Cascade)
  stepExecutions RecoveryStepExecution[]

  @@unique([recoveryPlanId, stepNumber])
  @@index([recoveryPlanId])
}

model RecoveryExecution {
  id               String    @id @default(uuid())
  executionCode    String    @unique
  recoveryPlanId   String
  status           String    @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, FAILED, CANCELLED, ROLLBACK_REQUIRED
  triggerType      String    // MANUAL, SCHEDULED, INCIDENT, DRILL, AUTOMATED
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  initiatedById    String?
  currentStep      Int?
  errorMessage     String?
  correlationId    String?
  metadataJson     String?
  createdAt        DateTime  @default(now())

  recoveryPlan   RecoveryPlan            @relation(fields: [recoveryPlanId], references: [id], onDelete: Cascade)
  initiatedBy    User?                   @relation("RecoveryInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  stepExecutions RecoveryStepExecution[]

  @@index([recoveryPlanId])
  @@index([status])
  @@index([startedAt])
  @@index([correlationId])
}

model RecoveryStepExecution {
  id                  String    @id @default(uuid())
  recoveryExecutionId String
  recoveryStepId      String
  status              String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, SKIPPED, RETRYING
  startedAt           DateTime?
  completedAt         DateTime?
  outputSummary       String?
  errorMessage        String?
  attemptCount        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  recoveryExecution RecoveryExecution @relation(fields: [recoveryExecutionId], references: [id], onDelete: Cascade)
  recoveryStep      RecoveryStep      @relation(fields: [recoveryStepId], references: [id], onDelete: Cascade)

  @@unique([recoveryExecutionId, recoveryStepId])
  @@index([recoveryExecutionId])
  @@index([recoveryStepId])
  @@index([status])
}

model ResilienceDependency {
  id                   String   @id @default(uuid())
  dependencyCode       String   @unique
  name                 String
  serviceName          String
  dependencyType       String   // DATABASE, CACHE, STORAGE, EXTERNAL_API, INTEGRATION, MESSAGING, AUTHENTICATION, INTERNAL_SERVICE, THIRD_PARTY
  criticality          String   // CRITICAL, HIGH, MEDIUM, LOW
  healthCheckReference String?
  fallbackStrategy     String?
  rpoMinutes           Int?
  rtoMinutes           Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([dependencyType])
  @@index([criticality])
  @@index([isActive])
}

model ContinuityPlan {
  id                              String    @id @default(uuid())
  planCode                        String    @unique
  name                            String
  description                     String?
  businessFunction                String
  criticality                     String    // CRITICAL, HIGH, MEDIUM, LOW
  minimumOperatingLevel           String?
  maximumTolerableDowntimeMinutes Int
  status                          String    @default("DRAFT") // DRAFT, ACTIVE, UNDER_REVIEW, RETIRED
  ownerId                         String?
  lastReviewedAt                  DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  owner      User?                @relation("ContinuityPlanOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  procedures ContinuityProcedure[]

  @@index([status])
  @@index([criticality])
  @@index([businessFunction])
}

model ContinuityProcedure {
  id               String   @id @default(uuid())
  continuityPlanId String
  procedureCode    String   @unique
  name             String
  sequence         Int
  description      String?
  responsibleRole  String?
  dependencyJson   String?
  fallbackAction   String?
  isRequired       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  continuityPlan ContinuityPlan @relation(fields: [continuityPlanId], references: [id], onDelete: Cascade)

  @@unique([continuityPlanId, sequence])
  @@index([continuityPlanId])
}

model ResilienceIncident {
  id                  String    @id @default(uuid())
  incidentCode        String    @unique
  name                String
  description         String?
  severity            String    // CRITICAL, HIGH, MEDIUM, LOW
  status              String    @default("OPEN") // OPEN, ACKNOWLEDGED, ASSESSING, RECOVERING, MONITORING, RESOLVED, CLOSED
  source              String    // MONITORING, BACKUP, RECOVERY, INTEGRATION, SECURITY, DATABASE, INFRASTRUCTURE, MANUAL
  detectedAt          DateTime  @default(now())
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?
  recoveryExecutionId String?
  rootCause           String?
  impactSummary       String?
  correlationId       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([source])
  @@index([detectedAt])
  @@index([correlationId])
}

model RecoveryAuditLog {
  id                  String   @id @default(uuid())
  eventCode           String   @unique
  recoveryPlanId      String?
  backupExecutionId   String?
  recoveryExecutionId String?
  incidentId          String?
  eventType           String
  message             String
  metadataJson        String?
  correlationId       String?
  createdAt           DateTime @default(now())

  @@index([eventType])
  @@index([recoveryPlanId])
  @@index([backupExecutionId])
  @@index([recoveryExecutionId])
  @@index([incidentId])
  @@index([correlationId])
  @@index([createdAt])
}

// ============================================================================
// MODULE 21: ENTERPRISE DOCUMENT, KNOWLEDGE & RECORDS MANAGEMENT ENGINE
// ============================================================================

model DocumentFolder {
  id            String           @id @default(uuid())
  folderCode    String           @unique
  name          String
  description   String?
  parentFolderId String?
  parentFolder  DocumentFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: SetNull)
  subFolders    DocumentFolder[] @relation("FolderHierarchy")
  ownerId       String?
  owner         User?            @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  visibility    String           @default("ORGANIZATION")
  isSystem      Boolean          @default(false)
  documents     Document[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([parentFolderId])
  @@index([ownerId])
  @@index([visibility])
}

model Document {
  id               String                 @id @default(uuid())
  documentCode     String                 @unique
  title            String
  description      String?
  documentType     String                 @default("GENERAL")
  status           String                 @default("ACTIVE")
  folderId         String?
  folder           DocumentFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?                  @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId   String?
  currentVersionId String?
  classification   String                 @default("INTERNAL")
  visibility       String                 @default("ORGANIZATION")
  mimeType         String?
  fileSizeBytes    Int?
  storageReference String
  checksum         String?
  isArchived       Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  versions         DocumentVersion[]
  metadata         DocumentMetadata?
  tags             DocumentTagAssignment[]
  permissions      DocumentPermission[]
  shares           DocumentShare[]
  approvals        DocumentApproval[]
  relations        DocumentRelation[]
  activityLogs     DocumentActivityLog[]
  legalHolds       RecordLegalHold[]
  knowledgeEntries KnowledgeEntry[]

  @@index([documentType])
  @@index([status])
  @@index([classification])
  @@index([folderId])
  @@index([ownerId])
  @@index([visibility])
  @@index([isArchived])
  @@index([currentVersionId])
}

model DocumentVersion {
  id               String                @id @default(uuid())
  versionCode      String                @unique
  documentId       String
  document         Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int
  storageReference String
  checksum         String?
  mimeType         String?
  fileSizeBytes    Int?
  changeSummary    String?
  createdById      String?
  createdBy        User?                 @relation("VersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())

  approvals        DocumentApproval[]
  activityLogs     DocumentActivityLog[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([createdById])
}

model DocumentMetadata {
  id             String    @id @default(uuid())
  documentId     String    @unique
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  metadataJson   String    @default("{}")
  tagsJson       String?
  language       String?
  author         String?
  source         String?
  effectiveDate  DateTime?
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DocumentTag {
  id          String                  @id @default(uuid())
  tagCode     String                  @unique
  name        String
  description String?
  assignments DocumentTagAssignment[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model DocumentTagAssignment {
  id         String      @id @default(uuid())
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String
  tag        DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model DocumentPermission {
  id          String    @id @default(uuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  subjectId   String
  subjectType String
  permission  String
  grantedById String?
  grantedBy   User?     @relation("PermissionGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([documentId])
  @@index([subjectId])
  @@index([subjectType])
  @@index([permission])
}

model DocumentShare {
  id            String    @id @default(uuid())
  shareCode     String    @unique
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWithId  String?
  sharedWithType String   @default("USER")
  permission    String    @default("VIEW")
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdBy     User?     @relation("ShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([documentId])
  @@index([sharedWithId])
  @@index([shareCode])
  @@index([expiresAt])
  @@index([revokedAt])
}

model DocumentApproval {
  id            String          @id @default(uuid())
  approvalCode  String          @unique
  documentId    String
  document      Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId     String
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  status        String          @default("PENDING")
  requestedById String?
  requestedBy   User?           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewerId    String?
  reviewer      User?           @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  requestedAt   DateTime        @default(now())
  reviewedAt    DateTime?
  comments      String?

  @@index([documentId])
  @@index([versionId])
  @@index([status])
  @@index([reviewerId])
  @@index([requestedById])
}

model KnowledgeCollection {
  id             String           @id @default(uuid())
  collectionCode String           @unique
  name           String
  description    String?
  visibility     String           @default("ORGANIZATION")
  ownerId        String?
  owner          User?            @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isActive       Boolean          @default(true)
  entries        KnowledgeEntry[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([ownerId])
  @@index([visibility])
  @@index([isActive])
}

model KnowledgeEntry {
  id               String              @id @default(uuid())
  entryCode        String              @unique
  collectionId     String
  collection       KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  title            String
  content          String
  status           String              @default("DRAFT")
  sourceDocumentId String?
  sourceDocument   Document?           @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  version          Int?                @default(1)
  authorId         String?
  author           User?               @relation("KnowledgeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedBy       User?               @relation("KnowledgeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedAt      DateTime?
  chunks           KnowledgeChunk[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([collectionId])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
}

model KnowledgeChunk {
  id               String         @id @default(uuid())
  entryCode        String
  knowledgeEntryId String
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)
  chunkIndex       Int
  content          String
  tokenCount       Int?
  checksum         String?
  metadataJson     String?
  createdAt        DateTime       @default(now())

  @@unique([knowledgeEntryId, chunkIndex])
  @@index([knowledgeEntryId])
  @@index([entryCode])
}

model DocumentRelation {
  id                String   @id @default(uuid())
  relationCode      String   @unique
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  relatedEntityType String
  relatedEntityId   String
  relationType      String   @default("ATTACHMENT")
  createdById       String?
  createdBy         User?    @relation("RelationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@index([documentId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([relationType])
}

model DocumentActivityLog {
  id            String           @id @default(uuid())
  activityCode  String           @unique
  documentId    String?
  document      Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId     String?
  version       DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  activityType  String
  actorId       String?
  actor         User?            @relation("DocumentActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  message       String
  metadataJson  String?
  correlationId String?
  createdAt     DateTime         @default(now())

  @@index([documentId])
  @@index([activityType])
  @@index([actorId])
  @@index([correlationId])
  @@index([createdAt])
}

model RecordRetentionPolicy {
  id                 String   @id @default(uuid())
  policyCode         String   @unique
  name               String
  description        String?
  documentType       String
  retentionDays      Int
  legalHoldSupported Boolean  @default(true)
  autoArchive        Boolean  @default(false)
  autoDelete         Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([documentType])
  @@index([isActive])
}

model RecordLegalHold {
  id           String    @id @default(uuid())
  holdCode     String    @unique
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reason       String
  placedById   String?
  placedBy     User?     @relation("LegalHoldPlacer", fields: [placedById], references: [id], onDelete: SetNull)
  releasedById String?
  releasedBy   User?     @relation("LegalHoldReleaser", fields: [releasedById], references: [id], onDelete: SetNull)
  placedAt     DateTime  @default(now())
  releasedAt   DateTime?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([documentId])
  @@index([status])
  @@index([placedAt])
}








